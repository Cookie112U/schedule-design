DirectoryIndex index.html

<IfModule mod_headers.c>
  # The HTML shell must be revalidated on every visit so it can expose new asset versions.
  <FilesMatch "\.(?:html?)$">
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>

  <FilesMatch "^(?:robots\.txt|sitemap\.xml|site\.webmanifest)$">
    Header always set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # These URLs carry a release version in index.html and can be cached aggressively.
  <FilesMatch "\.(?:css|js|png|jpe?g|gif|svg|webp|ico|woff2?)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml
</IfModule>
