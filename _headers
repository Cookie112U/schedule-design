/
  Cache-Control: no-cache, max-age=0, must-revalidate
/index.html
  Cache-Control: no-cache, max-age=0, must-revalidate
/robots.txt
  Cache-Control: no-cache, must-revalidate
/sitemap.xml
  Cache-Control: no-cache, must-revalidate
/css/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable
/Img/*
  Cache-Control: public, max-age=31536000, immutable
